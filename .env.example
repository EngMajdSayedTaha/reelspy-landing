# The product dashboard's own deployment URL, no trailing slash.
#
# Two things depend on this:
#   1. lib/showcase/fetch.ts — the "Live from the product" trending section.
#      When this is unset, getShowcase() returns curated fixtures immediately,
#      so the section silently renders demo data instead of real reels. That is
#      the intended production fallback, but locally it means the section is
#      NEVER live until you set this.
#   2. next.config.ts — the multi-zone rewrites to the dashboard.
#
# Local development against a deployed dashboard:
#   DASHBOARD_URL=https://your-dashboard-deployment.vercel.app
# Local development against the dashboard running on your machine:
#   DASHBOARD_URL=http://localhost:3000
DASHBOARD_URL=

# Microsoft Clarity (heatmaps + session recordings), clarity.microsoft.com.
# Deliberately the SAME project id as the dashboard app, so the funnel from
# this marketing site into the product is one continuous journey in Clarity
# rather than two disconnected projects. Only fires after the visitor accepts
# the cookie banner (app/layout.tsx reads the cookie_consent cookie set by
# components/legal/CookieConsent.tsx). Not a secret — falls back to the
# ReelSpy prod project id (xuzukpwv8n) if unset.
NEXT_PUBLIC_CLARITY_PROJECT_ID=xuzukpwv8n
